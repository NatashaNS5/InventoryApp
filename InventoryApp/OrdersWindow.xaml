<Window x:Class="InventoryApp.ViewModels.OrdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InventoryApp.ViewModels"
        mc:Ignorable="d"
        Title="Список заказов" Height="450" Width="800" MinHeight="450" MinWidth="800">
    <Window.Resources>
        <SolidColorBrush x:Key="SecondaryColor1" Color="#D1EEFC"/>
        <SolidColorBrush x:Key="SecondaryColor2" Color="#FFFCDA"/>
        <Style x:Key="AlternatingRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="AlternationIndex" Value="0">
                    <Setter Property="Background" Value="{StaticResource SecondaryColor1}"/>
                </Trigger>
                <Trigger Property="AlternationIndex" Value="1">
                    <Setter Property="Background" Value="{StaticResource SecondaryColor2}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="10">
            <Image Source="/Images/logo-01.jpg" Width="50" Height="50"/>
            <TextBlock Text="Список заказов" FontSize="18" FontWeight="Bold" Margin="10,0,0,0"/>
        </StackPanel>
        <DataGrid x:Name="OrdersGrid" Grid.Row="1" AutoGenerateColumns="False" Margin="10" AlternationCount="2">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Номер" Binding="{Binding OrderNumber}" Width="*"/>
                <DataGridTextColumn Header="Дата" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                <DataGridTextColumn Header="Количество изделий" Binding="{Binding TotalItems}" Width="150"/>
                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                <DataGridTextColumn Header="Заказчик" Binding="{Binding Customer}" Width="150"/>
                <DataGridTextColumn Header="Менеджер" Binding="{Binding Manager}" Width="150"/>
            </DataGrid.Columns>
            <DataGrid.RowStyle>
                <Style TargetType="DataGridRow" BasedOn="{StaticResource AlternatingRowStyle}"/>
            </DataGrid.RowStyle>
        </DataGrid>
    </Grid>
</Window>